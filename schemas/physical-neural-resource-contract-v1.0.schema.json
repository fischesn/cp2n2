    "TimingRegime": {
      "description": "Coarse-grained execution regime used for scheduling and matching.",
      "enum": [
        "microseconds",
        "milliseconds",
        "seconds",
        "minutes",
        "variable"
      ],
      "title": "TimingRegime",
      "type": "string"
    },
    "TrainingMode": {
      "description": "Supported learning/programming mode for a backend.",
      "enum": [
        "none",
        "pretrained",
        "ex_situ",
        "in_situ",
        "hybrid"
      ],
      "title": "TrainingMode",
      "type": "string"
    },
    "TwinBinding": {
      "additionalProperties": false,
      "description": "Link between a physical/logical backend and its digital twin representation.",
      "properties": {
        "calibration_confidence": {
          "default": 1.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Calibration Confidence",
          "type": "number"
        },
        "fidelity_level": {
          "description": "Human-readable fidelity label.",
          "title": "Fidelity Level",
          "type": "string"
        },
        "last_calibrated_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ISO 8601 timestamp if known.",
          "title": "Last Calibrated At"
        },
        "twin_kind": {
          "description": "Type of twin, e.g. ode_simulation or replay_model.",
          "title": "Twin Kind",
          "type": "string"
        },
        "twin_notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Twin Notes"
        }
      },
      "required": [
        "twin_kind",
        "fidelity_level"
      ],
      "title": "TwinBinding",
      "type": "object"
    },
    "Uncertainty": {
      "additionalProperties": false,
      "description": "Explicit uncertainty metadata; unknown is never encoded as zero.",
      "properties": {
        "confidence": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "kind": {
          "$ref": "#/$defs/UncertaintyKind"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "kind"
      ],
      "title": "Uncertainty",
      "type": "object"
    },
    "UncertaintyKind": {
      "description": "Representation used for uncertainty attached to an observation.",
      "enum": [
        "unknown",
        "none",
        "standard_deviation",
        "interval",
        "qualitative"
      ],
      "title": "UncertaintyKind",
      "type": "string"
    }
  },
